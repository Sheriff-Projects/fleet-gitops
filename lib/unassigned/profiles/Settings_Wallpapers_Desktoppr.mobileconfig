<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.scriptingosx.desktoppr</string>
            <key>PayloadIdentifier</key>
            <string>com.scriptingosx.desktoppr.settings</string>
            <key>PayloadUUID</key>
            <string>EB868014-75DA-44A9-B019-74AC9E31ADBD</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadDisplayName</key>
            <string>Desktoppr Settings</string>
            <key>PayloadEnabled</key>
            <true/>

            <!-- Chemin du wallpaper (fichier précis ou dossier pour rotation) -->
            <key>picture</key>
            <string>/Users/Shared/sp_wallpapers/Wallpaper Retina Black_SHERIFF_PROJECTS.jpg</string>

            <!-- Mise à l'échelle : fill | stretch | center | fit -->
            <key>scale</key>
            <string>fill</string>

            <!-- Couleur de fond (hex sans #) -->
            <!--
            <key>color</key>
            <string>000000</string>
            -->

            <!-- Forcer la réapplication même si l'utilisateur a changé le wallpaper -->
            <!-- false = laisse l'utilisateur choisir après le 1er run               -->
            <!-- true  = force le wallpaper à chaque run (toutes les 3h)             -->
            <key>manage</key>
            <string>once</string>
            <!-- Valeurs possibles : "once" | "always" -->
        </dict>
    </array>

    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadIdentifier</key>
    <string>com.sheriff-projects.desktoppr</string>
    <key>PayloadUUID</key>
    <string>EB868014-75DA-44A9-B019-74AC9E31ADBD</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadDisplayName</key>
    <string>Wallpaper S•P</string>
    <key>PayloadDescription</key>
    <string>Configure le wallpaper d'entreprise via desktoppr</string>
    <key>PayloadOrganization</key>
    <string>Sheriff Projects</string>
    <key>PayloadScope</key>
    <string>System</string>
</dict>
</plist>
